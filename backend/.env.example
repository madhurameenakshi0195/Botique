# Neon: Dashboard > Connection details. Build the JDBC url from host and database name, keep sslmode=require.
DB_URL=jdbc:postgresql://ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password
# At least 32 characters, random
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# The one admin account (created or updated automatically on start)
ADMIN_EMAIL=rani@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Allowed website addresses, comma separated, no trailing slash
FRONTEND_URL=http://localhost:5500,https://your-site.vercel.app
PORT=4000
